#!/bin/sh
#
# Refuses commits on main. Work on develop (or a branch made from it), then open a pull request from develop into
# main on GitHub to release to production.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "main" ]; then
    echo ""
    echo "  Commits on main are not allowed."
    echo "  Switch to develop:  git switch develop"
    echo "  main only changes through a pull request from develop on GitHub."
    echo ""
    exit 1
fi

exit 0
