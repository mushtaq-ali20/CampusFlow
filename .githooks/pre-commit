#!/bin/sh
#
# Refuses commits on main and develop. Work on a feature branch made from develop, then open a pull request into
# develop on GitHub. main (production) only changes through a pull request from develop.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "main" ] || [ "$branch" = "develop" ]; then
    echo ""
    echo "  Commits on $branch are not allowed."
    echo "  Make a feature branch from develop:"
    echo "      git switch develop && git pull && git switch -c feature/<short-name>"
    echo "  Your uncommitted changes come along to the new branch."
    echo ""
    exit 1
fi

exit 0
